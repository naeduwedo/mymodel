<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    MSIX identity for GGUF AI Engine.

    Version is the four-part MSIX form; it must match Cargo's package version
    plus a build revision. The build script rewrites this file into the staging
    layout with the real version, so this copy is the template.

    Publisher must match the signing certificate's subject exactly, or the
    package will not install. The placeholder is replaced at signing time; an
    unsigned package (as produced here) installs only in developer mode.
  -->
  <Identity
    Name="GGUFAIEngine.Core"
    Publisher="CN=GGUF AI Engine Development"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>GGUF AI Engine</DisplayName>
    <PublisherDisplayName>GGUF AI Engine contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Local GGUF model manager and inference platform</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="Shell"
      Executable="shell\GgufAiEngine.Shell.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="GGUF AI Engine"
        Description="Local GGUF model manager and inference platform"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <!--
      Only what the product actually needs:
      * runFullTrust  - the shell launches gguf-core as a child process;
      * internetClient - Hugging Face model download.

      No broadFileSystemAccess: the app writes only inside its own data
      directory, which the packaging layout provides (spec §15).
    -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
