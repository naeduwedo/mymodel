<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows shell for GGUF AI Engine (spec §2.1, §4).

    WinUI 3 + Windows App SDK, C#/XAML, unpackaged (self-contained directory)
    for the moment so it can be launched without MSIX registration during
    development. Packaging is Task 9.

    The shell is deliberately thin: it renders the snapshot produced by the
    core (proto/ui.proto) and owns no policy of its own.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GgufAiEngine.Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- Trimming/AOT are off: WinUI 3 does not fully support them yet. -->
    <PublishTrimmed>false</PublishTrimmed>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Generated gRPC stubs land here. An explicit output directory plus an
         explicit Compile include is used instead of relying on Grpc.Tools to
         augment the compile list: the WinUI XAML compiler runs before the
         language compile, and the implicit augmentation does not survive that
         ordering. -->
    <ProtoOutDir>$(MSBuildProjectDirectory)\Generated</ProtoOutDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Grpc.Tools" Version="2.68.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Endpoint derivation and snapshot mapping live in a toolkit-free library
         so they can be unit tested without a window. -->
    <ProjectReference Include="..\GgufAiEngine.Shell.Core\GgufAiEngine.Shell.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated stubs are compiled by the Core library and arrive here
         through the project reference; compiling them twice would define the
         same protobuf types in two assemblies (CS0436). -->
    <Compile Remove="Generated\*.cs" />
    <None Include="Generated\*.cs" />
  </ItemGroup>

  <!--
    C# stubs for the protobuf contract are generated, not hand-written, and are
    committed under Generated/ so a plain `dotnet build` works without the
    protobuf compiler and without ordering tricks.

    Why committed: in a WinUI project, XamlPreCompile runs a C# pre-pass before
    CoreCompile and reads its file list early, so files produced by a build
    target are not seen in time. Committing the stubs removes that ordering
    dependency entirely.

    Regenerate with:  pwsh scripts/generate-csharp-protos.ps1
    CI verifies the committed stubs match proto/ (see .github/workflows/ci.yml),
    so the contract cannot drift.
  -->

</Project>