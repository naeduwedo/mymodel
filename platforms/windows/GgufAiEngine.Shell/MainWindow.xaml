<Window
    x:Class="GgufAiEngine.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GgufAiEngine.Shell"
    Title="GGUF AI Engine">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Connection status strip: the shell's own state, distinct from the
             core's state, so "UI cannot reach core" is never shown as "core is
             stopped". -->
        <InfoBar
            x:Name="ConnectionBar"
            Grid.Row="0"
            Severity="Error"
            IsOpen="True"
            Title="Not connected"
            Message="Looking for the core..."
            IsClosable="False" />

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview" Icon="Home" IsSelected="True" />
                <NavigationViewItem Content="Chat" Tag="chat" Icon="Message" />
                <NavigationViewItem Content="Create" Tag="create" Icon="Pictures" />
                <NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
            </NavigationView.MenuItems>

            <ScrollViewer x:Name="ContentScroller" Padding="24">
                <StackPanel Spacing="16">
                    <StackPanel x:Name="OverviewPanel" Spacing="16">
                        <TextBlock Text="Overview" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="OverviewTimestamp"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Waiting for the core..." />
                        <ItemsControl x:Name="TileList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,8">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                Text="{Binding Label}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Opacity="0.7" />
                                            <TextBlock
                                                Text="{Binding Value}"
                                                Style="{StaticResource SubtitleTextBlockStyle}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{Binding Detail}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Opacity="0.7"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding DetailVisibility}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Capabilities" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsControl x:Name="FeatureList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="24,*,Auto" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding Glyph}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock
                                                Text="{Binding Reason}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Opacity="0.7"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding StatusText}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Opacity="0.7" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel x:Name="ChatPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Chat" Style="{StaticResource TitleTextBlockStyle}" />

                        <!-- The model is chosen by id from the registry; a free-text
                             box would let a typo become a confusing core error. -->
                        <Grid ColumnDefinitions="Auto,*,Auto,120" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="Model" VerticalAlignment="Center" />
                            <TextBox
                                x:Name="ModelBox"
                                Grid.Column="1"
                                PlaceholderText="repository id, e.g. ggml-org/models"
                                TextChanged="OnModelChanged" />
                            <TextBlock Grid.Column="2" Text="Max tokens" VerticalAlignment="Center" />
                            <NumberBox
                                x:Name="MaxTokensBox"
                                Grid.Column="3"
                                Value="256"
                                Minimum="1"
                                Maximum="8192"
                                SpinButtonPlacementMode="Compact" />
                        </Grid>

                        <InfoBar
                            x:Name="ChatBar"
                            Severity="Informational"
                            IsOpen="False"
                            IsClosable="False" />

                        <!-- The transcript: user and assistant turns, in order. -->
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            MinHeight="240">
                            <ScrollViewer x:Name="TranscriptScroller" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                                <ItemsControl x:Name="TranscriptList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="2" Margin="0,0,0,12">
                                                <TextBlock
                                                    Text="{Binding Speaker}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Opacity="0.7" />
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox
                                x:Name="PromptBox"
                                Grid.Column="0"
                                PlaceholderText="Ask something..."
                                AcceptsReturn="False"
                                KeyDown="OnPromptKeyDown" />
                            <Button
                                x:Name="SendButton"
                                Grid.Column="1"
                                Content="Send"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="OnSendClicked" />
                            <Button x:Name="StopButton" Grid.Column="2" Content="Stop" Click="OnStopClicked" IsEnabled="False" />
                        </Grid>

                        <TextBlock
                            x:Name="ChatStatus"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Opacity="0.7"
                            Text="Choose a model that is already downloaded." />
                    </StackPanel>

                    <StackPanel x:Name="CreatePanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Create" Style="{StaticResource TitleTextBlockStyle}" />

                        <!-- Image generation. The runtime is a separate process; if it
                             is not running the core answers FAILED_PRECONDITION and
                             the bar below shows why. -->
                        <TextBlock Text="Image" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBox x:Name="ImagePromptBox" PlaceholderText="Describe the image..." />
                        <Grid ColumnDefinitions="Auto,120,Auto,120,Auto,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="Width" VerticalAlignment="Center" />
                            <NumberBox x:Name="ImageWidthBox" Grid.Column="1" Value="512" Minimum="64" Maximum="2048" SpinButtonPlacementMode="Compact" />
                            <TextBlock Grid.Column="2" Text="Height" VerticalAlignment="Center" />
                            <NumberBox x:Name="ImageHeightBox" Grid.Column="3" Value="512" Minimum="64" Maximum="2048" SpinButtonPlacementMode="Compact" />
                            <Button x:Name="GenerateImageButton" Grid.Column="4" Content="Generate" Style="{StaticResource AccentButtonStyle}" Click="OnGenerateImageClicked" />
                        </Grid>
                        <TextBlock x:Name="ImageStatus" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />

                        <!-- Video is a minutes-long job, so it shows its stage and step
                             count instead of a spinner that cannot tell working from hung. -->
                        <TextBlock Text="Video" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBox x:Name="VideoPromptBox" PlaceholderText="Describe the clip..." />
                        <Grid ColumnDefinitions="Auto,100,Auto,100,Auto,100,Auto,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="Frames" VerticalAlignment="Center" />
                            <NumberBox x:Name="VideoFramesBox" Grid.Column="1" Value="17" Minimum="1" Maximum="257" SpinButtonPlacementMode="Compact" />
                            <TextBlock Grid.Column="2" Text="Steps" VerticalAlignment="Center" />
                            <NumberBox x:Name="VideoStepsBox" Grid.Column="3" Value="8" Minimum="1" Maximum="60" SpinButtonPlacementMode="Compact" />
                            <TextBlock Grid.Column="4" Text="FPS" VerticalAlignment="Center" />
                            <NumberBox x:Name="VideoFpsBox" Grid.Column="5" Value="8" Minimum="1" Maximum="30" SpinButtonPlacementMode="Compact" />
                            <Button x:Name="GenerateVideoButton" Grid.Column="6" Content="Generate clip" Click="OnGenerateVideoClicked" />
                        </Grid>
                        <ProgressBar x:Name="VideoProgressBar" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="VideoStatus" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />

                        <TextBlock Text="Music" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBox x:Name="MusicPromptBox" PlaceholderText="Describe the music (English)..." />
                        <Grid ColumnDefinitions="Auto,100,Auto,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="Seconds" VerticalAlignment="Center" />
                            <NumberBox x:Name="MusicDurationBox" Grid.Column="1" Value="10" Minimum="1" Maximum="600" SpinButtonPlacementMode="Compact" />
                            <Button x:Name="GenerateMusicButton" Grid.Column="2" Content="Generate music" Click="OnGenerateMusicClicked" />
                            <TextBlock x:Name="MusicStatus" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                        </Grid>

                        <TextBlock Text="Speech" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBox x:Name="SpeechTextBox" PlaceholderText="Text to speak..." />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Button x:Name="SpeakButton" Grid.Column="0" Content="Synthesise" Click="OnSpeakClicked" />
                            <TextBlock x:Name="SpeechStatus" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                        </Grid>

                        <InfoBar
                            x:Name="CreateBar"
                            Severity="Informational"
                            IsOpen="False"
                            IsClosable="False" />
                    </StackPanel>

                    <StackPanel x:Name="SettingsPanel" Spacing="16" Visibility="Collapsed">
                        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="SettingsSource"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Loading..." />
                        <InfoBar
                            x:Name="SettingsIssueBar"
                            Severity="Warning"
                            IsOpen="False"
                            IsClosable="False" />
                        <ItemsControl x:Name="SettingGroups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="6" Margin="0,8,0,8">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="220,*,Auto" Margin="0,3">
                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{Binding Value}"
                                                            FontFamily="Consolas"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Grid.Column="2"
                                                            Text="{Binding Note}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Opacity="0.6"
                                                            MaxWidth="320"
                                                            TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>

        <Grid Grid.Row="2" Padding="16,8">
            <TextBlock
                x:Name="StatusLine"
                Style="{StaticResource CaptionTextBlockStyle}"
                Opacity="0.7"
                Text="Starting..." />
        </Grid>
    </Grid>
</Window>